+/* Recount after a clear without replacing the clear operation's per-root
+ * deleted/failed/skipped counters.  One root report is sufficient because
+ * the remaining byte total is accumulated before the next root starts. */
+static int scan_cache_remaining(uint8_t include_logs, uint32_t *bytes) {
+    struct shellpp_cache_root_report root;
+    uint32_t root_count = include_logs ? 5u : 4u;
+    int overall = SHELLPP_FS_OK;
+    if (!bytes) return SHELLPP_FS_ERR_ARGUMENT;
+    *bytes = 0u;
+    for (uint32_t index = 0u; index < root_count; ++index) {
+        int check;
+        clear_bytes(&root, sizeof(root));
+        if (index == 0u) root.path = g_cache_path;
+        else if (index == 1u) root.path = g_tmp_path;
+        else if (index == 2u) root.path = g_system_log_path;
+        else if (index == 3u) root.path = g_offline_log_path;
+        else root.path = g_shellpp_logs_path;
+        check = root_type(root.path, &root.exists);
+        if (check != SHELLPP_FS_OK) {
+            if (root.exists) overall = check;
+            continue;
+        }
+        if (!root.exists) continue;
+        (void)copy_text(g_work_path, sizeof(g_work_path), root.path);
+        if (walk_directory(text_length(g_work_path, sizeof(g_work_path)), 0u,
+                0u, &root) != SHELLPP_FS_OK)
+            overall = SHELLPP_FS_ERR_DIRECTORY;
+        add_saturated(bytes, root.bytes);
+    }
+    return overall;
+}
